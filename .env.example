DATABASE_URL=mysql+pymysql://careerradar:careerradar@127.0.0.1:3306/careerradar
SOURCE_SYNC_ENABLED=false
# Optional server-side key. Do not put credentials in provider configuration JSON.
# HIMALAYAS_API_KEY=
USER_COUNTRY=ZW
USER_UTC_OFFSET=UTC+02:00
REQUEST_TIMEOUT=20
MAX_REQUESTS=500
MAX_QUERIES=100
MAX_PAGES=20
MAX_RETRIES=3
MAX_RETRY_WAIT=60
REQUEST_INTERVAL=1.1
VERIFICATION_BUDGET=50
VERIFICATION_MAX_AGE_HOURS=24
# Optional JSON file overriding Criteria fields: roles, employment_types, country, utc_offset.
# CRITERIA_PATH=criteria.json
